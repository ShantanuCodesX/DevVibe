<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Resume - Devvibe</title>

    <link
        rel="stylesheet"
        href="/resume.css"
    >

</head>


<body>


    <!-- Navbar -->

    <nav class="resume-navbar">

        <a href="/profile" class="brand">
            Devvibe
        </a>

        <a href="/profile">
            Back to Profile
        </a>

    </nav>



    <main class="resume-container">


        <!-- Header -->

        <div class="resume-page-header">

            <div>

                <h1>
                    My Resume
                </h1>

                <p>
                    Build an ATS-friendly resume from your Devvibe profile.
                </p>

            </div>

        </div>



        <!-- Resume Actions -->

        <section class="resume-actions-card">

            <div class="action-info">

                <h2>
                    Resume Manager
                </h2>

                <p>
                    Update your resume, preview it and download your
                    professional ATS-friendly version.
                </p>

            </div>


            <div class="resume-buttons">

                <a
                    href="/resume/edit"
                    class="primary-btn"
                >
                    Edit Resume
                </a>


                <a
                    href="/resume/preview"
                    class="secondary-btn"
                >
                    Preview Resume
                </a>


                <a
                    href="/resume/download"
                    class="download-btn"
                >
                    Download PDF
                </a>

            </div>

        </section>



        <!-- ATS Information -->

        <section class="ats-card">

            <div class="ats-icon">
                ✓
            </div>

            <div>

                <h2>
                    ATS-Friendly Resume
                </h2>

                <p>
                    Your resume uses a clean single-column structure,
                    standard headings and readable formatting designed
                    to work well with Applicant Tracking Systems.
                </p>

            </div>

        </section>



        <!-- Resume Structure -->

        <section class="resume-structure">

            <h2>
                Resume Structure
            </h2>

            <div class="structure-grid">

                <div class="structure-item">

                    <strong>
                        Personal Information
                    </strong>

                    <span>
                        Name and email from your account
                    </span>

                </div>


                <div class="structure-item">

                    <strong>
                        Professional Summary
                    </strong>

                    <span>
                        Your resume summary
                    </span>

                </div>


                <div class="structure-item">

                    <strong>
                        Skills
                    </strong>

                    <span>
                        Skills from your profile
                    </span>

                </div>


                <div class="structure-item">

                    <strong>
                        Experience
                    </strong>

                    <span>
                        Your professional experience
                    </span>

                </div>


                <div class="structure-item">

                    <strong>
                        Projects
                    </strong>

                    <span>
                        Projects from your Devvibe portfolio
                    </span>

                </div>


                <div class="structure-item">

                    <strong>
                        Education
                    </strong>

                    <span>
                        Your educational background
                    </span>

                </div>

            </div>

        </section>



    </main>


</body>

</html>