<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Devvibe</title>
    <link rel="stylesheet" href="/auth.css">
</head>

<body>

<main class="auth-page">

    <section class="auth-intro">
        <div class="brand-logo">Devvibe</div>

        <h1>Your work deserves to be seen.</h1>

      

        <div class="intro-points">
            <div>
                <i class="fa-solid fa-code"></i>
                <span>Showcase your real projects</span>
            </div>

            <div>
                <i class="fa-solid fa-user"></i>
                <span>Manage your developer profile</span>
            </div>

            <div>
                <i class="fa-solid fa-link"></i>
                <span>Share your portfolio with one link</span>
            </div>
        </div>
    </section>

    <section class="auth-card">

        <h2>Welcome back</h2>

        <p class="auth-description">
            Log in to continue to your Devvibe profile.
        </p>

        <form action="/auth/login" method="POST">

            <div class="form-group">
                <label for="email">Email Address</label>
                <input
                    id="email"
                    type="email"
                    name="email"
                    placeholder="Enter your email"
                    autocomplete="email"
                    required
                >
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <input
                    id="password"
                    type="password"
                    name="password"
                    placeholder="Enter your password"
                    autocomplete="current-password"
                    required
                >
            </div>

            <button type="submit">
                Log In
            </button>

        </form>

        <p class="auth-link">
            Don't have an account?
            <a href="/auth/signup">Create an account</a>
        </p>

    </section>

</main>

<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/js/all.min.js"></script>

</body>
</html>