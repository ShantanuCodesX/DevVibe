<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Projects - Devvibe</title>
    <link rel="stylesheet" href="/projects.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>

<body>

<nav class="project-navbar">

    <a href="/dashboard" class="brand">
        Devvibe
    </a>

    <a href="/profile/search" class="desktop-search">
        <i class="fa-solid fa-magnifying-glass"></i>
        <span>Search developers...</span>
    </a>

    <a href="/dashboard" class="dashboard-link">
        <i class="fa-solid fa-house"></i>
        Dashboard
    </a>

</nav>

<aside class="project-sidebar">

    <div class="sidebar-menu">

        <a href="/dashboard" class="menu-item">
            <span class="menu-icon">
                <i class="fa-solid fa-house"></i>
            </span>
            Home
        </a>

        <a href="/projects" class="menu-item active">
            <span class="menu-icon">
                <i class="fa-solid fa-file"></i>
            </span>
            Projects
        </a>

        <a href="/projects/add" class="menu-item">
            <span class="menu-icon">
                <i class="fa-solid fa-folder-plus"></i>
            </span>
            Add Project
        </a>

        <a href="/settings" class="menu-item">
            <span class="menu-icon">
                <i class="fa-solid fa-gear"></i>
            </span>
            Settings
        </a>

    </div>

    <a href="/profile" class="sidebar-profile">

        <% if (user.profileImage) { %>

            <img
                src="<%= user.profileImage %>"
                alt="<%= user.name %>"
                class="sidebar-profile-image"
            >

        <% } else { %>

            <div class="sidebar-profile-placeholder">
                <%= user.name.charAt(0).toUpperCase() %>
            </div>

        <% } %>

        <span class="sidebar-profile-name">
            <%= user.name %>
        </span>

    </a>

</aside>

<main class="project-container">

    <div class="page-heading project-heading">

        <div>
            <h1>Project Manager</h1>
            <p>Manage your proof of work.</p>
        </div>

        <a href="/projects/add" class="add-project-btn">
            <i class="fa-solid fa-plus"></i>
            Add New Project
        </a>

    </div>

    <% if (projects.length === 0) { %>

        <div class="empty-projects">

            <div class="empty-icon">
                <i class="fa-regular fa-folder-open"></i>
            </div>

            <h2>No projects yet</h2>

            <p>Add your first project to showcase your work.</p>

            <a href="/projects/add" class="add-project-btn">
                <i class="fa-solid fa-plus"></i>
                Add Project
            </a>

        </div>

    <% } else { %>

        <div class="project-list">

            <% projects.forEach(project => { %>

                <article class="project-card">

                    <% if (project.screenshots && project.screenshots.length > 0) { %>

                        <div class="project-screenshots">

                            <% project.screenshots.forEach((image, index) => { %>

                                <img
                                    src="<%= image %>"
                                    alt="<%= project.name %> screenshot <%= index + 1 %>"
                                    class="project-screenshot"
                                    loading="lazy"
                                >

                            <% }) %>

                        </div>

                    <% } %>

                    <div class="project-body">

                        <div class="project-details">

                            <h2>
                                <%= project.name %>
                            </h2>

                            <% if (project.description) { %>

                                <p class="project-description">
                                    <%= project.description %>
                                </p>

                            <% } %>

                            <% if (project.techStack && project.techStack.length > 0) { %>

                                <div class="tech-list">

                                    <% project.techStack.forEach(tech => { %>

                                        <span>
                                            <%= tech %>
                                        </span>

                                    <% }) %>

                                </div>

                            <% } %>

                            <% if (project.liveLink || project.sourceCode) { %>

                                <div class="project-links">

                                    <% if (project.liveLink) { %>

                                        <a
                                            href="<%= project.liveLink %>"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="live-btn"
                                        >
                                            <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                            Live App
                                        </a>

                                    <% } %>

                                    <% if (project.sourceCode) { %>

                                        <a
                                            href="<%= project.sourceCode %>"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="source-btn"
                                        >
                                            <i class="fa-brands fa-github"></i>
                                            Source Code
                                        </a>

                                    <% } %>

                                </div>

                            <% } %>

                        </div>

                        <div class="project-actions">

                            <a
                                href="/projects/edit/<%= project._id %>"
                                class="edit-btn"
                            >
                                <i class="fa-solid fa-pen"></i>
                                Edit
                            </a>

                            <form
                                action="/projects/delete/<%= project._id %>"
                                method="POST"
                            >

                                <button
                                    type="submit"
                                    class="delete-btn"
                                >
                                    <i class="fa-solid fa-trash"></i>
                                    Delete
                                </button>

                            </form>

                        </div>

                    </div>

                </article>

            <% }) %>

        </div>

    <% } %>

</main>

<nav class="mobile-bottom-nav">

    <a href="/dashboard" class="mobile-nav-item">
        <i class="fa-solid fa-house"></i>
        <span>Home</span>
    </a>

    <a href="/projects" class="mobile-nav-item active">
        <i class="fa-solid fa-file"></i>
        <span>Projects</span>
    </a>

    <a href="/projects/add" class="mobile-nav-item add-nav-item">
        <span class="add-icon">
            <i class="fa-solid fa-plus"></i>
        </span>
        <span>Add</span>
    </a>

    <a href="/profile/search" class="mobile-nav-item">
        <i class="fa-solid fa-magnifying-glass"></i>
        <span>Search</span>
    </a>

    <a href="/profile" class="mobile-nav-item profile-nav-item">

        <% if (user.profileImage) { %>

            <img
                src="<%= user.profileImage %>"
                alt="<%= user.name %>"
                class="mobile-profile-image"
            >

        <% } else { %>

            <span class="mobile-profile-placeholder">
                <%= user.name.charAt(0).toUpperCase() %>
            </span>

        <% } %>

        <span class="mobile-profile-name">
            <%= user.name %>
        </span>

    </a>

</nav>

</body>
</html>