<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= user.name %> - Devvibe</title>
    <link rel="stylesheet" href="/profile.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>

<body>

<nav class="profile-navbar">
    <a href="/" class="brand">Devvibe</a>

    <button type="button" class="share-portfolio" onclick="sharePortfolio()">
        <i class="fa-solid fa-share-nodes"></i>
        <span>Share Portfolio</span>
    </button>
</nav>

<main class="profile-container">

    <section class="profile-card">

        <div class="profile-top">

            <div class="profile-image-container">
                <% if (user.profileImage) { %>
                    <img
                        src="<%= user.profileImage %>"
                        alt="<%= user.name %>"
                        class="profile-image"
                    >
                <% } else { %>
                    <div class="profile-placeholder">
                        <%= user.name.charAt(0).toUpperCase() %>
                    </div>
                <% } %>
            </div>

            <div class="profile-heading">
                <h1><%= user.name %></h1>

                <% if (user.headline) { %>
                    <h2><%= user.headline %></h2>
                <% } else { %>
                    <h2>Full Stack Developer</h2>
                <% } %>
            </div>

        </div>

        <div class="profile-details">

            <% if (user.bio) { %>
                <p class="bio"><%= user.bio %></p>
            <% } else { %>
                <p class="bio">I build useful and modern digital experiences.</p>
            <% } %>

            <% if (user.skills && user.skills.length > 0) { %>
                <div class="skills">
                    <% user.skills.forEach(skill => { %>
                        <span><%= skill %></span>
                    <% }) %>
                </div>
            <% } %>

            <div class="social-links">
                <% if (user.github) { %>
                    <a href="<%= user.github %>" target="_blank" rel="noopener noreferrer">
                        <i class="fa-brands fa-github"></i>
                        GitHub
                    </a>
                <% } %>

                <% if (user.linkedin) { %>
                    <a href="<%= user.linkedin %>" target="_blank" rel="noopener noreferrer">
                        <i class="fa-brands fa-linkedin"></i>
                        LinkedIn
                    </a>
                <% } %>

                <% if (user.instagram) { %>
                    <a href="<%= user.instagram %>" target="_blank" rel="noopener noreferrer">
                        <i class="fa-brands fa-instagram"></i>
                        Instagram
                    </a>
                <% } %>
            </div>

            <div class="profile-actions">
                <a href="/profile/edit" class="action-btn edit-profile-btn">
                    <i class="fa-solid fa-pen"></i>
                    Edit Profile
                </a>

                <a href="/resume" class="action-btn resume-btn">
                    <i class="fa-solid fa-file-arrow-down"></i>
                    Download Resume
                </a>
            </div>

            <a href="/settings" class="settings-btn">
                <i class="fa-solid fa-gear"></i>
                <span>
                    <strong>Settings</strong>
                    <small>Manage your account and preferences</small>
                </span>
                <i class="fa-solid fa-chevron-right"></i>
            </a>

        </div>

    </section>

    <section class="proof-section">

        <div class="section-title">
            <h2>Proof of Work</h2>
            <p>Projects I've built and shipped.</p>
        </div>

        <% if (!projects || projects.length === 0) { %>

            <div class="no-projects">
                <div class="empty-icon">
                    <i class="fa-solid fa-folder-open"></i>
                </div>
                <h3>No projects yet</h3>
                <p>Projects will appear here when they are added.</p>
            </div>

        <% } else { %>

            <div class="proof-projects">

                <% projects.forEach(project => { %>

                    <article class="proof-project-card">

                        <% if (project.screenshots && project.screenshots.length > 0) { %>
                            <div class="proof-images">
                                <% project.screenshots.forEach((screenshot, index) => { %>
                                    <img
                                        src="<%= screenshot %>"
                                        alt="<%= project.name %> screenshot <%= index + 1 %>"
                                        class="proof-image"
                                        loading="lazy"
                                    >
                                <% }) %>
                            </div>
                        <% } %>

                        <div class="proof-content">

                            <h3><%= project.name %></h3>

                            <% if (project.description) { %>
                                <p><%= project.description %></p>
                            <% } %>

                            <% if (project.techStack && project.techStack.length > 0) { %>
                                <div class="proof-tech">
                                    <% project.techStack.forEach(tech => { %>
                                        <span><%= tech %></span>
                                    <% }) %>
                                </div>
                            <% } %>

                            <% if (project.liveLink || project.sourceCode) { %>
                                <div class="proof-links">

                                    <% if (project.liveLink) { %>
                                        <a href="<%= project.liveLink %>" target="_blank" rel="noopener noreferrer">
                                            <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                            Live App
                                        </a>
                                    <% } %>

                                    <% if (project.sourceCode) { %>
                                        <a href="<%= project.sourceCode %>" target="_blank" rel="noopener noreferrer">
                                            <i class="fa-brands fa-github"></i>
                                            Source Code
                                        </a>
                                    <% } %>

                                </div>
                            <% } %>

                        </div>

                    </article>

                <% }) %>

            </div>

        <% } %>

    </section>

</main>

<script>
async function sharePortfolio() {
    const portfolioUrl = window.location.origin + "/profile/user/<%= user._id %>";

    if (navigator.share) {
        try {
            await navigator.share({
                title: "<%= user.name %> - Devvibe",
                text: "Check out my portfolio on Devvibe",
                url: portfolioUrl
            });
        } catch (error) {}
        return;
    }

    alert("Sharing is not supported in this browser.\n\nPortfolio URL:\n" + portfolioUrl);
}
</script>

</body>
</html>