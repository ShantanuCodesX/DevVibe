<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Edit Project - Devvibe</title>

    <link
        rel="stylesheet"
        href="/edit-project.css"
    >

    <!-- Font Awesome -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    >

</head>

<body>

    <!-- =========================
         NAVBAR
    ========================== -->

    <nav class="project-navbar">

        <a href="/projects" class="brand">
            <i class="fa-solid fa-code"></i>
            Devvibe
        </a>

        <a
            href="/projects"
            class="back-link"
        >
            <i class="fa-solid fa-arrow-left"></i>
            Back to Projects
        </a>

    </nav>


    <!-- =========================
         MAIN
    ========================== -->

    <main class="project-container">

        <div class="page-heading">

            <div>

                <span class="heading-icon">
                    <i class="fa-solid fa-pen-to-square"></i>
                </span>

                <h1>Edit Project</h1>

                <p>
                    Update your project details and showcase your work.
                </p>

            </div>

        </div>


        <!-- =========================
             FORM
        ========================== -->

        <form
            action="/projects/edit/<%= project._id %>"
            method="POST"
            enctype="multipart/form-data"
            class="project-form"
        >


            <!-- PROJECT DETAILS -->

            <section class="form-section">

                <div class="section-title">

                    <i class="fa-solid fa-circle-info"></i>

                    <div>
                        <h2>Project Details</h2>
                        <p>Basic information about your project.</p>
                    </div>

                </div>


                <div class="form-group">

                    <label for="name">
                        Project Name
                    </label>

                    <input
                        id="name"
                        type="text"
                        name="name"
                        value="<%= project.name %>"
                        placeholder="e.g. Job Application Tracker"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="description">
                        Description
                    </label>

                    <textarea
                        id="description"
                        name="description"
                        rows="5"
                        placeholder="Describe what your project does..."
                        required
                    ><%= project.description %></textarea>

                </div>


                <div class="form-group">

                    <label for="techStack">
                        Tech Stack
                    </label>

                    <input
                        id="techStack"
                        type="text"
                        name="techStack"
                        value="<%= project.techStack.join(', ') %>"
                        placeholder="Node.js, Express, MongoDB, EJS"
                    >

                    <small>
                        Separate technologies with commas.
                    </small>

                </div>

            </section>


            <!-- LINKS -->

            <section class="form-section">

                <div class="section-title">

                    <i class="fa-solid fa-link"></i>

                    <div>
                        <h2>Project Links</h2>
                        <p>Add links where people can view your project.</p>
                    </div>

                </div>


                <div class="form-group">

                    <label for="liveLink">
                        <i class="fa-solid fa-globe"></i>
                        Live App
                    </label>

                    <input
                        id="liveLink"
                        type="url"
                        name="liveLink"
                        value="<%= project.liveLink %>"
                        placeholder="https://your-project.com"
                    >

                </div>


                <div class="form-group">

                    <label for="sourceCode">
                        <i class="fa-brands fa-github"></i>
                        Source Code
                    </label>

                    <input
                        id="sourceCode"
                        type="url"
                        name="sourceCode"
                        value="<%= project.sourceCode %>"
                        placeholder="https://github.com/username/project"
                    >

                </div>

            </section>


            <!-- SCREENSHOTS -->

            <section class="form-section">

                <div class="section-title">

                    <i class="fa-solid fa-image"></i>

                    <div>
                        <h2>Project Screenshot</h2>
                        <p>Update the screenshot displayed with your project.</p>
                    </div>

                </div>


                <% if (project.screenshots && project.screenshots.length > 0) { %>

                    <div class="current-image">

                        <span class="image-label">
                            Current Screenshot
                        </span>

                        <img
                            src="<%= project.screenshots[0] %>"
                            alt="<%= project.name %> screenshot"
                        >

                    </div>

                <% } %>


                <div class="upload-box">

                    <i class="fa-solid fa-cloud-arrow-up upload-icon"></i>

                    <h3>
                        Replace Screenshot
                    </h3>

                    <p>
                        Upload a new image for your project.
                    </p>

                    <label class="upload-btn">

                        <i class="fa-solid fa-upload"></i>
                        Choose Image

                        <input
                            type="file"
                            name="screenshots"
                            accept="image/png,image/jpeg,image/webp"
                        >

                    </label>

                    <small>
                        PNG, JPG or WEBP
                    </small>

                </div>

            </section>


            <!-- ACTIONS -->

            <div class="form-actions">

                <a
                    href="/projects"
                    class="cancel-btn"
                >
                    <i class="fa-solid fa-xmark"></i>
                    Cancel
                </a>

                <button
                    type="submit"
                    class="save-btn"
                >
                    <i class="fa-solid fa-check"></i>
                    Update Project
                </button>

            </div>


        </form>

    </main>

</body>

</html>