<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Devhub - Developer Portfolio</title>

    <link
        rel="stylesheet"
        href="/index.css"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    >

</head>

<body>

    <!-- =========================
         NAVBAR
    ========================== -->

    <nav class="navbar">

        <a href="/" class="logo">
            <i class="fa-solid fa-code"></i>
            <span>Devhub</span>
        </a>


        <div class="nav-right">

            <a
                href="/auth/login"
                class="login-btn"
            >
                Login
            </a>

            <a
                href="/auth/signup"
                class="signup-btn"
            >
                Signup
            </a>

        </div>

    </nav>


    <!-- =========================
         HERO
    ========================== -->

    <main class="hero">

        <div class="hero-content">

            <div class="hero-badge">
                <i class="fa-solid fa-code"></i>
                Built for Developers
            </div>


            <h1>
                Build Your
                <span>Developer Portfolio</span>
            </h1>


            <p>
                Showcase your projects, skills and real-world work
                in one professional portfolio.
            </p>


            <div class="hero-buttons">

                <a
                    href="/auth/signup"
                    class="primary-btn"
                >
                    <i class="fa-solid fa-rocket"></i>
                    Create Your Portfolio
                </a>


                <a
                    href="/auth/login"
                    class="secondary-btn"
                >
                    Login
                    <i class="fa-solid fa-arrow-right"></i>
                </a>

            </div>


            <div class="hero-note">

                <i class="fa-solid fa-check"></i>

                Free to get started

            </div>

        </div>

    </main>

</body>

</html>